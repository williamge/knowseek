#!/usr/bin/env bash
# Preflight for the Ollama-backed adapters (ADR 0016, ADR 0025).
#
# With EMBEDDINGS_ADAPTER=ollama (the default) the app needs a running Ollama
# with the embedding model. With PLANNER_ADAPTER=ollama (opt in) it also needs
# the chat model of the query planner. This script checks both and pulls a
# model if it is missing. It loads no .env: the Makefile does that (LOAD_ENV).
#
#   - neither adapter is ollama: exit 0, no output
#   - ollama CLI missing or server not answering: exit 1 with the fix
#   - embedding model missing: `ollama pull` (about 1.2 GB for bge-m3)
#   - embedding model output is not 1024 dimensions: exit 1 (chunks.embedding is vector(1024))
#   - PLANNER_ADAPTER=ollama and chat model missing: `ollama pull` (about 1.4 GB
#     for qwen3:1.7b); the model must then answer a one-token /api/chat call
#   - all good: one line per checked model, exit 0
#
# Usage: scripts/ensure-ollama
# Variables: EMBEDDINGS_ADAPTER (ollama), OLLAMA_URL (http://localhost:11434),
#            OLLAMA_MODEL (bge-m3), PLANNER_ADAPTER (passthrough),
#            OLLAMA_CHAT_MODEL (qwen3:1.7b). The defaults match
#            Knowseek.Embeddings.Ollama and Knowseek.Discovery.Planner.Ollama.

set -euo pipefail

body="$(mktemp)"
trap 'rm -f "$body"' EXIT

# Values are trimmed, like config/runtime.exs does; an empty one is unset.
value() {
  trimmed="$(printf '%s' "${!1:-}" | tr -d '[:space:]')"
  printf '%s' "${trimmed:-$2}"
}

adapter="$(value EMBEDDINGS_ADAPTER ollama)"
planner="$(value PLANNER_ADAPTER passthrough)"
url="$(value OLLAMA_URL http://localhost:11434)"
model="$(value OLLAMA_MODEL bge-m3)"
chat_model="$(value OLLAMA_CHAT_MODEL qwen3:1.7b)"
dimensions=1024

embeddings=no
[ "$adapter" = "ollama" ] && embeddings=yes
planning=no
[ "$planner" = "ollama" ] && planning=yes

[ "$embeddings" = "yes" ] || [ "$planning" = "yes" ] || exit 0

optout_embeddings="To run without Ollama (word matching only, no semantics), set EMBEDDINGS_ADAPTER=hashing in .env."
optout_planner="To search the query as typed, without a planning model, set PLANNER_ADAPTER=passthrough in .env."

# fail <message> <fix> [embeddings|planner]: with no third argument, every
# opt-out that applies is printed.
fail() {
  echo "ensure-ollama: $1" >&2
  echo "$2" >&2
  case "${3:-}" in
    embeddings) echo "$optout_embeddings" >&2 ;;
    planner) echo "$optout_planner" >&2 ;;
    *)
      [ "$embeddings" = "yes" ] && echo "$optout_embeddings" >&2
      [ "$planning" = "yes" ] && echo "$optout_planner" >&2
      ;;
  esac
  exit 1
}

# listed <model>: true when the tags JSON lists the model.
listed() {
  grep -Fq -e "\"name\":\"$1\"" -e "\"name\":\"$1:latest\"" <<<"$tags"
}

command -v ollama >/dev/null ||
  fail "the ollama CLI is not installed." "Run: brew install ollama && brew services start ollama"

curl -sf -m 2 "$url/api/version" >/dev/null ||
  fail "Ollama does not answer on $url." "Run: brew services start ollama   (or: ollama serve)"

tags="$(curl -sf -m 5 "$url/api/tags")" ||
  fail "could not list models on $url." "Run: brew services restart ollama"

if [ "$embeddings" = "yes" ]; then
  if ! listed "$model"; then
    echo "ensure-ollama: pulling $model (first run only, about 1.2 GB)..."
    OLLAMA_HOST="$url" ollama pull "$model" ||
      fail "could not pull $model." "Run: OLLAMA_HOST=$url ollama pull $model" embeddings
  fi

  # One tiny embed call also loads the model, which keeps it warm for the app.
  echo "ensure-ollama: loading model $model (can take a minute the first time)..."
  status="$(curl -s -m 120 -o "$body" -w '%{http_code}' "$url/api/embed" -d "{\"model\":\"$model\",\"input\":\"x\"}")" || status="no answer"
  [ "$status" = "200" ] ||
    fail "$model did not answer /api/embed on $url (HTTP status: $status)." "Check the model name in OLLAMA_MODEL, and the Ollama log (brew services info ollama)." embeddings
  reply="$(cat "$body")"
  count="$(sed -E 's/.*"embeddings":\[\[([^]]*)\].*/\1/' <<<"$reply" | tr ',' '\n' | wc -l | tr -d ' ')"
  [ "$count" = "$dimensions" ] ||
    fail "$model outputs $count dimensions, the index needs $dimensions." "Use a $dimensions-dimension model (default bge-m3) or add a migration (docs/decisions/0004-embeddings.md)." embeddings

  echo "ensure-ollama: OK ($model)"
fi

if [ "$planning" = "yes" ]; then
  if ! listed "$chat_model"; then
    if [ "$chat_model" = "qwen3:1.7b" ]; then
      size="about 1.4 GB"
    else
      size="a model of a size this script does not know"
    fi
    echo "ensure-ollama: pulling the query planner model $chat_model (first run only, downloading $size)..."
    OLLAMA_HOST="$url" ollama pull "$chat_model" ||
      fail "could not pull $chat_model." "Run: OLLAMA_HOST=$url ollama pull $chat_model   (or pick another model with OLLAMA_CHAT_MODEL)" planner
  fi

  # One one-token chat call loads the model, so the first discovery job does not
  # pay for it. It sends the same num_ctx and keep_alive as Planner.Ollama: Ollama
  # starts a new runner when the context size differs, and the job would reload.
  echo "ensure-ollama: loading the query planner model $chat_model..."
  status="$(curl -s -m 120 -o "$body" -w '%{http_code}' "$url/api/chat" -d "{\"model\":\"$chat_model\",\"stream\":false,\"keep_alive\":\"5m\",\"options\":{\"num_ctx\":1024,\"num_predict\":1},\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}")" || status="no answer"
  [ "$status" = "200" ] ||
    fail "$chat_model did not answer /api/chat on $url (HTTP status: $status)." "Check the model name in OLLAMA_CHAT_MODEL (it must be a chat model, not an embedding model), and the Ollama log (brew services info ollama)." planner

  echo "ensure-ollama: OK (query planner model $chat_model)"
fi
