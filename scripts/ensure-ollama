#!/usr/bin/env bash
# Preflight for the default embedding adapter (ADR 0016).
#
# With EMBEDDINGS_ADAPTER=ollama (the default) the app needs a running Ollama
# with the embedding model. This script checks that and pulls the model if it
# is missing. It loads no .env: the Makefile does that (LOAD_ENV).
#
#   - adapter is not ollama: exit 0, no output
#   - ollama CLI missing or server not answering: exit 1 with the fix
#   - model missing: `ollama pull` (about 1.2 GB for bge-m3)
#   - model output is not 1024 dimensions: exit 1 (chunks.embedding is vector(1024))
#   - all good: one line, exit 0
#
# Usage: scripts/ensure-ollama
# Variables: EMBEDDINGS_ADAPTER (ollama), OLLAMA_URL (http://localhost:11434),
#            OLLAMA_MODEL (bge-m3). The defaults match Knowseek.Embeddings.Ollama.

set -euo pipefail

adapter="${EMBEDDINGS_ADAPTER:-ollama}"
url="${OLLAMA_URL:-http://localhost:11434}"
model="${OLLAMA_MODEL:-bge-m3}"
dimensions=1024

[ "$adapter" = "ollama" ] || exit 0

optout="To run without Ollama (word matching only, no semantics), set EMBEDDINGS_ADAPTER=hashing in .env."

fail() {
  echo "ensure-ollama: $1" >&2
  echo "$2" >&2
  echo "$optout" >&2
  exit 1
}

command -v ollama >/dev/null ||
  fail "the ollama CLI is not installed." "Run: brew install ollama && brew services start ollama"

curl -sf -m 2 "$url/api/version" >/dev/null ||
  fail "Ollama does not answer on $url." "Run: brew services start ollama   (or: ollama serve)"

tags="$(curl -sf -m 5 "$url/api/tags")" ||
  fail "could not list models on $url." "Run: brew services restart ollama"

if ! grep -Eq "\"name\":\"$model(:latest)?\"" <<<"$tags"; then
  echo "ensure-ollama: pulling $model (first run only, about 1.2 GB)..."
  OLLAMA_HOST="$url" ollama pull "$model" ||
    fail "could not pull $model." "Run: OLLAMA_HOST=$url ollama pull $model"
fi

# One tiny embed call also loads the model, which keeps it warm for the app.
reply="$(curl -sf -m 120 "$url/api/embed" -d "{\"model\":\"$model\",\"input\":\"x\"}")" ||
  fail "$model did not answer /api/embed on $url." "Run: OLLAMA_HOST=$url ollama pull $model"
count="$(sed -E 's/.*"embeddings":\[\[([^]]*)\].*/\1/' <<<"$reply" | tr ',' '\n' | wc -l | tr -d ' ')"
[ "$count" = "$dimensions" ] ||
  fail "$model outputs $count dimensions, the index needs $dimensions." "Use a $dimensions-dimension model (default bge-m3) or add a migration (docs/decisions/0004-embeddings.md)."

echo "ensure-ollama: OK ($model)"
