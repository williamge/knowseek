#!/usr/bin/env bash
# Scans the whole git history of a repository for secrets with gitleaks, using
# the repository's .gitleaks.toml. CI runs this in the `secrets` job.
#
# Needs Docker. The official image runs as your user and sees the repository at
# its own path, so a git worktree (whose .git file points into the main
# checkout's .git directory) works too. A shallow clone scans only what it has,
# so CI checks out with fetch-depth: 0.
#
# Prints the finding with the secret redacted and exits 1 when there is one.
#
# Usage: scripts/check-secrets [repository-path]   (default: this repository)
#        GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1 scripts/check-secrets

set -euo pipefail

repo="$(cd "${1:-$(dirname "${BASH_SOURCE[0]}")/..}" && pwd)"
image="${GITLEAKS_IMAGE:-ghcr.io/gitleaks/gitleaks:latest}"
common="$(cd "$repo" && git rev-parse --path-format=absolute --git-common-dir)"

exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  --volume "$repo:$repo" \
  --volume "$common:$common:ro" \
  --workdir "$repo" \
  "$image" git "$repo" --config "$repo/.gitleaks.toml" --redact --no-banner --verbose
